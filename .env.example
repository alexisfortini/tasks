# Copy to .env for local configuration. Never commit the populated .env.
# Existing .private/account.json remains the fallback when this is blank.
GOOGLE_TASKS_ACCOUNT_EMAIL=
# Optional when generating a new tunnel profile; preserve your existing tunnel.
GOOGLE_TASKS_TUNNEL_ID=
# Restricted OpenAI runtime API key, with Tunnels Read + Use only.
# This is not a Google OAuth token. Set only after approving persistent storage.
# Use one line, optionally quoted. Blank uses the existing Windows DPAPI key.
CONTROL_PLANE_API_KEY=
